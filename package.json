    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tslib": "^2.5.2",
    "tsx": "^4.21.0",
    "typescript": "^5.1.6",
    "vite": "^8.0.8"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "three": "^0.185.0",
    "ws": "^8.20.0"
