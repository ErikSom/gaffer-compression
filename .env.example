# Point the client at the remote game server. Read by `vite build` and baked into
# the static bundle. Set this in your Cloudflare Pages build environment.
#
# Leave it unset for local dev — the client falls back to the same-origin /ws,
# which Vite proxies to ws://localhost:8787.
VITE_WS_URL=wss://your-server.onrender.com
