# Copy to ./.env in the repo root on the VM (docker compose reads it automatically).
#
# The public hostname clients connect to. Must have a DNS A record pointing at the
# VM's public IP. Caddy gets a Let's Encrypt cert for exactly this name.
SITE_ADDRESS=gaffer.example.com

# Contact email for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com
